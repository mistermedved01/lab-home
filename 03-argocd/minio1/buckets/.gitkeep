# Эта директория зарезервирована для управления buckets через GitOps
# Когда BucketRequest CRD станет доступен в MinIO Operator, здесь будут файлы вида:
#
# bucket-logs.yaml
# bucket-backups.yaml
# bucket-media.yaml
#
# Пример структуры (когда CRD будет доступен):
# ---
# apiVersion: minio.min.io/v2
# kind: BucketRequest
# metadata:
#   name: logs
#   namespace: minio-operator
# spec:
#   bucketName: logs
