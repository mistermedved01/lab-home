# Пример конфигурации для Terraform
# Скопируйте этот файл в terraform.tfvars и заполните реальными значениями
# terraform.tfvars уже добавлен в .gitignore и не будет коммититься в репозиторий
#
# Поддерживается несколько узлов Proxmox: укажите proxmox_nodes и для каждой VM — proxmox_node.

# Узлы Proxmox: ключ — идентификатор ноды, значение — endpoint, api_token, node_name
# В кластере Proxmox один API token действует для всех узлов — укажите один и тот же для обоих
# Сейчас в конфиге заложены два узла (pve-node-01 и pve-node-02); оба ключа обязательны.
# Если у вас один узел — укажите его данные в обоих блоках (одинаковый endpoint и node_name).
proxmox_nodes = {
  "pve-node-01" = {
    endpoint       = "https://192.168.40.151:8006/"
    api_token      = "terraform@pve!terraform-token=YOUR_TOKEN_HERE"
    node_name      = "pve-node-01"
    datastore_id   = "local"
    network_bridge = "vmbr0"
  }
  "pve-node-02" = {
    endpoint       = "https://192.168.40.152:8006/"
    api_token      = "terraform@pve!terraform-token=YOUR_TOKEN_HERE"
    node_name      = "pve-node-02"
    datastore_id   = "local"
    network_bridge = "vmbr0"
  }
}

# IP-адрес шлюза для VM
gateway_ip = "192.168.40.1"

# ISO образ для создания VM (путь в datastore Proxmox)
iso_image = "local:iso/noble-server-cloudimg-amd64.img"

# SSH публичный ключ, который попадёт во все ВМ
# Получить: cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 YOUR_PUBLIC_KEY_HERE user@host"

# Список VM для создания
# Для каждой VM укажите proxmox_node — ключ из proxmox_nodes (на каком узле создавать VM)
vm_list = {
  ansible_control-01 = {
    vm_hostname     = "ansible-control-01"
    vm_ip           = "192.168.40.161"
    vm_id           = 1001
    vm_cores        = 2
    vm_memory       = 2000
    vm_disk_size    = 20
    cloud_init_file = "ansible-control.yaml.tftpl"
    role            = "ansible"
    proxmox_node    = "pve-node-01"
  }

  k8s_control-01 = {
    vm_hostname     = "k8s-control-01"
    vm_ip           = "192.168.40.162"
    vm_id           = 1002
    vm_cores        = 4
    vm_memory       = 4000
    vm_disk_size    = 30
    cloud_init_file = "k8s-control.yaml.tftpl"
    role            = "k8s_control"
    proxmox_node    = "pve-node-01"
  }

  k8s_worker-01 = {
    vm_hostname     = "k8s-worker-01"
    vm_ip           = "192.168.40.163"
    vm_id           = 1003
    vm_cores        = 4
    vm_memory       = 8000
    vm_disk_size    = 30
    #vm_disk_size_extra = 30
    cloud_init_file = "k8s-worker.yaml.tftpl"
    role            = "k8s_worker"
    proxmox_node    = "pve-node-01"
  }

  # k8s_worker-02 = {
  #   vm_hostname     = "k8s-worker-02"
  #   vm_ip           = "192.168.40.164"
  #   vm_id           = 1004
  #   vm_cores        = 4
  #   vm_memory       = 8000
  #   vm_disk_size    = 30
  #   cloud_init_file = "k8s-worker.yaml.tftpl"
  #   role            = "k8s_worker"
  #   proxmox_node    = "pve-node-02"
  # }
}

# Опциональные переменные (имеют значения по умолчанию)
# ansible_control_vm_key = "ansible_control-01"
# vm_user = "ubuntu"
# ansible_ssh_user = null
# ansible_ssh_key_path = "keys/id_ed25519"
# ansible_version = "13.3.0-1ppa~noble"
# network_cidr = 24
# snippets_datastore_id = "local"

# SSH ключ для подключения к Proxmox (для операций провайдера)
# proxmox_ssh_key_path = "keys/id_ed25519"
# proxmox_ssh_key_path = null   # по умолчанию ~/.ssh/id_ed25519
# proxmox_use_ssh_agent = true  # для CI/CD
