all:
  vars:
    ansible_user: ${vm_user}
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519

  children:
    kube_control_plane:
      hosts:
%{ for _, vm in inventory ~}
%{ if vm.role == "k8s_control" ~}
        ${vm.vm_hostname}:
          ansible_host: ${vm.vm_ip}
%{ endif ~}
%{ endfor ~}

    kube_node:
      hosts:
%{ for _, vm in inventory ~}
%{ if vm.role == "k8s_worker" ~}
        ${vm.vm_hostname}:
          ansible_host: ${vm.vm_ip}
%{ endif ~}
%{ endfor ~}

    etcd:
      hosts:
%{ for _, vm in inventory ~}
%{ if vm.role == "k8s_control" ~}
        ${vm.vm_hostname}:
          ansible_host: ${vm.vm_ip}
%{ endif ~}
%{ endfor ~}

    k8s_cluster:
      children:
        kube_control_plane:
        kube_node:

    proxmox:
      vars:
        ansible_user: root
        ansible_ssh_private_key_file: ~/.ssh/id_ed25519
      hosts:
%{ for h in proxmox_hosts ~}
        ${h.hostname}:
          ansible_host: ${h.ip}
          ansible_user: root
%{ endfor ~}