# Пример inventory файла для Ansible
# Этот файл показывает структуру inventory, который генерируется автоматически Terraform
# Реальный inventory находится в: 01-proxmox-terraform-k8s-ansible/live/ansible/inventory.yaml
# 
# Примечание: ansible_user в реальном inventory будет использовать значение из переменной vm_user
# (по умолчанию "ubuntu", но может быть изменено в terraform.tfvars)

all:
  children:
    k8s_control:
      hosts:
        k8s-control-01:
          ansible_host: 192.168.40.145
          ansible_user: ubuntu
          ansible_ssh_private_key_file: ../../01-proxmox-terraform-k8s-ansible/live/keys/id_ed25519
    
    k8s_worker:
      hosts:
        k8s-worker-01:
          ansible_host: 192.168.40.146
          ansible_user: ubuntu
          ansible_ssh_private_key_file: ../../01-proxmox-terraform-k8s-ansible/live/keys/id_ed25519
    
    ansible:
      hosts:
        ansible-control-01:
          ansible_host: 192.168.40.144
          ansible_user: ubuntu
          ansible_ssh_private_key_file: ../../01-proxmox-terraform-k8s-ansible/live/keys/id_ed25519

  vars:
    ansible_python_interpreter: /usr/bin/python3

